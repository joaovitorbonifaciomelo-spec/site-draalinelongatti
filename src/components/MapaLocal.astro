---
/* Mapa do Google Maps, sem chave de API. O próprio navegador só o carrega quando a seção se aproxima da tela,
   então a abertura da página não pede nada ao Google. */
import { contato } from "../data/site";

const c = contato.valor;
---
<div class="mapa">
  <iframe
    src={c.mapaEmbed}
    title={`Mapa do Google com a localização do ${c.predio}`}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>

<style is:global>
  .mapa {
    width: 100%; aspect-ratio: 4 / 3; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--areia) 35%, transparent);
    background: var(--marrom-midia);
  }
  .mapa iframe { display: block; width: 100%; height: 100%; border: 0; filter: sepia(.16) saturate(.86); }
</style>
