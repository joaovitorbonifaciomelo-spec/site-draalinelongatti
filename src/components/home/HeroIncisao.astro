---
import Midia from "../Midia.astro";
import { filmeHero, hero, registros, rotas } from "../../data/site";
import { marca } from "../../lib/provisorio";
import { achar } from "../../lib/midia";

/* Filme completo, de 14 s: 1080p no computador e 720p no celular */
const videos = { video: "/media/hero-desktop.mp4", videoMobile: "/media/hero-mobile.mp4" };
const temVideo = !!(achar(videos.video) || achar(videos.videoMobile));
/* O filme atual tem pessoa identificável: o build final falha enquanto isso não for resolvido */
if (temVideo) marca(filmeHero);
---
<section class="hero-quadro hero1" aria-labelledby="h1-titulo">
  <div class="camada papel">
    <p class="rotulo h1-vertical" aria-hidden="true">Nutrologia · Dermatologia</p>
    <h1 class="display h1-titulo" id="h1-titulo">A saúde tem<br>muitas <em>camadas.</em></h1>
    <div class="h1-intro">
      <p class="rotulo">{hero.rotulo}</p>
      <p class="lead" {...marca(hero.lead)}>{hero.lead.valor}</p>
      <div class="h1-acoes">
        <a class="cta" href={rotas.agendar}>Agendar consulta <span aria-hidden="true">→</span></a>
        <a class="link-seta" href="#especialidades">Conhecer as especialidades</a>
      </div>
      <dl class="h1-cred" {...marca(registros)}>
        {registros.valor.map(r => <div><dt>{r.rotulo}</dt><dd>{r.texto}</dd></div>)}
      </dl>
    </div>
  </div>

  <div class="camada janela">
    <div class="camada h1-empurra">
    <Midia {...videos} poster="/media/hero-desktop-poster" posterMobile="/media/hero-mobile-poster" prioridade>
      <div class="midia-zona"><span class="midia-rotulo">Zona da médica<br>plano médio · luz lateral</span></div>
      <span class="midia-rotulo j-rotulo-recorte">Fragmento do filme · aguarda edição</span>
      <span class="midia-rotulo j-rotulo-quadro">Quadro completo · hero-desktop.mp4 / hero-mobile.mp4</span>
      <span class="midia-rotulo j-rotulo-negativo">Espaço negativo planejado para a tipografia</span>
    </Midia>
    <div class="midia-veu"></div>
    <p class="display h1-titulo h1-titulo--copia" aria-hidden="true">A saúde tem<br>muitas <em>camadas.</em></p>
    {temVideo && (
      <div class="h1-controles">
        <button class="pausa" type="button" data-pausa hidden>
          <svg class="ico-pausar" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" width="3" height="12"/><rect x="7" width="3" height="12"/></svg>
          <svg class="ico-tocar" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 0l9 6-9 6z"/></svg>
          <span class="pausa-txt">Pausar vídeo</span>
        </button>
      </div>
    )}
    </div>
  </div>

  <div class="corte-linha" aria-hidden="true"></div>
</section>

<style is:global>
  /* ===== Hero I — Incisão =====
     A superfície (marfim) tem um corte. Pelo corte se vê um fragmento do filme.
     O título atravessa a borda do corte e muda de cor ao cruzá-la.
     Na rolagem, o corte cresce até o quadro inteiro, mas a faixa marfim do menu permanece: o contraste do menu não
     depende do filme. Nenhum texto some em fade: o corte cobre o que sai, e a nova incisão empurra o filme e o título. */

  :root {
    --col: calc((100vw - 2 * var(--m) - 11 * var(--gut)) / 12);
    --l0: calc(var(--m) + 6 * (var(--col) + var(--gut)));   /* o corte começa na coluna 7 */
    --t0: var(--nav-h);
    --incisao-x: 88%;          /* à direita da médica na cena do atendimento */
  }

  /* Palco: sem JS ou com "reduzir movimento", as camadas ficam empilhadas e legíveis */
  .palco {
    position: relative;
    --tit: min(11vw, 19vh);
    --tit-lh: .88;
    --tit-b: 5.2vh;
    /* A janela termina entre as duas linhas do título: "tem" atravessa o corte, e a borda de baixo passa pela segunda linha na abertura */
    --b0: calc(var(--tit-b) + var(--tit-lh) * var(--tit));

    /* ---- Pontos de ajuste para quando os vídeos definitivos chegarem ---- */
    --video-origem: 100% 45%;  /* ponto do quadro que fica fixo durante a abertura */
    --video-escala: 1.06;      /* corte fechado */
    --video-escala-aberta: 1.1;/* corte aberto: favorece a médica */
    --video-desloca: 5%;       /* corte fechado: aproxima a médica do centro da janela */
    --video-aproxima: .05;     /* aproximação durante a nova incisão */
    --veu: .6;                 /* acima disso, o título passa de 3:1 sobre qualquer quadro, até branco puro */
    --veu-linhas: 2;
    --veu-fade: 16vh;
    --veu-direita: calc(var(--m) + 7.4 * var(--tit)); /* o título termina aqui; à direita, o filme fica limpo */
  }
  .palco-fixo { position: relative; }
  .camada { position: absolute; inset: 0; }
  .hero-quadro { position: relative; height: 100vh; height: 100svh; overflow: hidden; }

  .anima .palco { height: 340vh; }
  .anima .palco-fixo { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .anima .hero-quadro { position: absolute; inset: 0; height: auto; z-index: 2; }

  .papel { background: var(--marfim); }
  /* O filme recebe o ponteiro onde aparece: o que ele cobre deixa de ser clicável */
  .janela { clip-path: inset(var(--t0) 0 calc(var(--b0) * (1 - var(--a, 0))) calc(var(--l0) * (1 - var(--a, 0)))); }
  .h1-empurra { transform: translateX(calc(var(--incisao-x) * var(--c, 0) * -1)); }
  .anima .janela { will-change: clip-path; }
  .hero1 .midia {
    transform-origin: var(--video-origem);
    transform:
      translateX(calc(var(--video-desloca) * (1 - var(--a, 0))))
      scale(calc(var(--video-escala) + (var(--video-escala-aberta) - var(--video-escala)) * var(--a, 0) + var(--video-aproxima) * var(--c, 0)));
  }
  /* Véu só na área do título. 2 px além da borda do corte: nenhuma linha do filme fica sem véu por arredondamento */
  .hero1 .midia-veu {
    --s: calc(var(--tit-b) + var(--veu-linhas) * var(--tit-lh) * var(--tit) + 1.5vh - var(--b0) * (1 - var(--a, 0)));
    bottom: calc(var(--b0) * (1 - var(--a, 0)) - 2px);
    background: linear-gradient(to top, rgb(var(--veu-rgb) / var(--veu)) 0, rgb(var(--veu-rgb) / var(--veu)) var(--s), rgb(var(--veu-rgb) / 0) calc(var(--s) + var(--veu-fade)));
    -webkit-mask-image: linear-gradient(to right, #000 var(--veu-direita), transparent calc(var(--veu-direita) + 14vw));
    mask-image: linear-gradient(to right, #000 var(--veu-direita), transparent calc(var(--veu-direita) + 14vw));
  }

  /* Título: duas cópias, uma em cada superfície, para mudar de cor exatamente na borda do corte */
  .h1-titulo {
    position: absolute; left: var(--m); bottom: var(--tit-b); margin: 0;
    font-size: var(--tit); line-height: var(--tit-lh); white-space: nowrap;
  }
  .papel .h1-titulo { color: var(--marrom); }
  .h1-titulo--copia { color: var(--marfim); }

  /* Bloco informativo: quem/onde · a frase · a ação · os registros */
  .h1-intro {
    position: absolute; left: var(--m); top: calc(var(--nav-h) + 5vh);
    width: calc(var(--l0) - var(--m) - 2 * var(--gut));
    display: grid; justify-items: start;
  }
  /* Só quando o corte já cobriu tudo: sai do Tab e dos leitores de tela, sem nenhuma mudança visível */
  .textos-fora .h1-intro, .textos-fora .h1-vertical { visibility: hidden; }
  .h1-intro .rotulo { color: var(--terracota); margin-bottom: clamp(12px, 1.2vw, 20px); }
  .h1-intro .lead { font-size: clamp(19px, 1.75vw, 34px); line-height: 1.36; max-width: 27ch; margin-bottom: clamp(20px, 2vw, 36px); letter-spacing: -.005em; }
  .h1-acoes { display: flex; align-items: center; gap: clamp(20px, 2vw, 36px); flex-wrap: wrap; margin-bottom: clamp(20px, 2.2vw, 40px); }
  .h1-cred {
    margin: 0; width: 100%; max-width: 34em;
    display: grid; grid-template-columns: repeat(3, auto); justify-content: start; column-gap: clamp(20px, 2vw, 36px);
    border-top: 1px solid var(--areia); padding-top: 12px;
    font-size: clamp(13px, .92vw, 17px);
  }
  .h1-cred dt { font-family: var(--f-mono); font-size: .82em; letter-spacing: .06em; text-transform: uppercase; color: var(--cinza); line-height: 1.5; }
  .h1-cred dd { margin: 0; font-weight: 500; line-height: 1.4; white-space: nowrap; }
  .h1-vertical { display: none; }

  /* Rótulos da área reservada: somem junto com ela quando há mídia real */
  .j-rotulo-recorte { left: calc(var(--l0) + 4vw); top: calc(var(--nav-h) + 30px); opacity: calc(1 - var(--a, 0)); }
  .j-rotulo-quadro { left: var(--m); top: calc(var(--nav-h) + 30px); opacity: calc((var(--a, 0) - .7) * 3.4 * (1 - var(--c, 0))); }
  .j-rotulo-negativo { left: var(--m); top: 40%; max-width: 30ch; opacity: var(--a, 0); }
  .midia-zona { position: absolute; left: 63%; top: 22%; width: 24%; bottom: 0; border: 1px dashed color-mix(in srgb, var(--areia) 55%, transparent); padding: 12px; }
  .midia-zona .midia-rotulo { position: relative; }

  /* Controle de pausa sem presença visual: só aparece no foco do teclado e segue disponível para leitores de tela.
     O ponteiro passa direto, porque não há nada para ver nem clicar. Fica à esquerda da nova incisão e sai com o filme */
  .h1-controles { position: absolute; right: calc(100% - var(--incisao-x) + 12px); top: calc(var(--t0) + 12px); }
  .hero-passou .h1-controles { visibility: hidden; }
  .pausa:not(:focus-visible) { opacity: 0; pointer-events: none; }
  .pausa {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-width: 44px; height: 44px; padding: 0 14px; cursor: pointer; pointer-events: auto;
    background: rgb(var(--veu-rgb) / .78); border: 1px solid color-mix(in srgb, var(--marfim) 45%, transparent); color: var(--marfim);
    font-family: var(--f-mono); font-size: clamp(11px, .78vw, 14px); letter-spacing: .08em; text-transform: uppercase;
    transition: background .25s, border-color .25s;
  }
  .pausa[hidden] { display: none; }
  .pausa:hover { background: var(--marrom); border-color: var(--marfim); }
  .pausa:focus-visible { outline: 2px solid var(--marfim); outline-offset: 2px; }
  .pausa svg { flex: none; width: 12px; height: 12px; fill: currentColor; }
  .pausa .ico-tocar { display: none; }
  .pausa[data-estado="pausado"] .ico-pausar { display: none; }
  .pausa[data-estado="pausado"] .ico-tocar { display: block; }

  /* Nova incisão */
  .corte-linha { display: none; }
  .anima .corte-linha {
    display: block; position: absolute; z-index: 4; left: var(--incisao-x); top: 0; bottom: 0; width: 1px; background: var(--marfim);
    transform: scaleY(var(--l, 0)); transform-origin: 50% 50%; opacity: calc(1 - var(--c, 0)); pointer-events: none;
  }

  /* Telas baixas de computador e celular deitado: mantém a ação e os registros */
  @media (min-width: 761px) and (max-height: 640px) {
    .h1-intro .rotulo, .h1-acoes .link-seta { display: none; }
    .h1-intro .lead { font-size: 17px; margin-bottom: 14px; }
    .h1-acoes { margin-bottom: 14px; }
    .midia-zona .midia-rotulo { display: none; }
  }
  @media (min-width: 761px) and (max-height: 500px) {
    .h1-intro { top: calc(var(--nav-h) + 4px); }
    .h1-intro .lead { display: none; }
    .h1-cred { padding-top: 6px; font-size: 12px; }
  }

  /* Celular: composição própria, calculada de baixo para cima para não colidir em nenhuma altura.
     A borda do corte cai exatamente entre a 1ª e a 2ª linha: nenhuma palavra é cortada na horizontal. */
  @media (max-width: 760px) {
    :root { --l0: 25vw; }
    .palco {
      --tit: min(15.6vw, 8.8svh);
      --tit-lh: .94;
      --pe: calc(82px + env(safe-area-inset-bottom, 0px)); /* zona do CTA fixo */
      --info: 94px;
      --tit-b: calc(var(--pe) + var(--info) + 12px);
      --b0: calc(var(--tit-b) + 2 * var(--tit-lh) * var(--tit));
      --veu-linhas: 3;
      --veu-fade: 7svh;
      --veu-direita: 100vw;
      /* Corte fechado: aproxima a partir do alto do quadro, para o letreiro filmado sair de trás do título */
      --video-desloca: 15%;
      --video-escala: 1.18;
      --video-escala-aberta: 1;
      --video-origem: 60% 8%;
    }
    /* O véu já ocupa toda a largura: sem máscara, a abertura do menu pinta mais rápido em celular simples */
    .hero1 .midia-veu { -webkit-mask-image: none; mask-image: none; }
    .h1-titulo { white-space: normal; }
    .h1-titulo em { display: block; }
    .h1-intro { top: auto; bottom: var(--pe); right: var(--m); width: auto; height: var(--info); align-content: end; }
    .h1-intro .rotulo, .h1-acoes { display: none; }
    .h1-intro .lead { font-size: 15px; line-height: 1.38; max-width: none; margin-bottom: 10px; letter-spacing: 0; }
    .h1-cred { justify-content: space-between; column-gap: 8px; max-width: none; padding-top: 8px; font-size: 12px; }
    .h1-cred dt { font-size: 9.5px; letter-spacing: .04em; }
    .h1-vertical {
      display: block; position: absolute; left: var(--m); top: calc(var(--nav-h) + 8px);
      writing-mode: vertical-rl; transform: rotate(180deg);
      font-size: 10.5px; color: var(--terracota);
    }
    .j-rotulo-recorte { left: calc(25vw + 22px); top: calc(var(--nav-h) + 22px); right: 62px; }
    .j-rotulo-quadro { top: calc(var(--nav-h) + 22px); right: var(--m); }
    .j-rotulo-negativo { display: none; }
    .midia-zona { left: 38%; top: 20%; width: 52%; height: 22%; bottom: auto; }
    .midia-zona .midia-rotulo { display: none; }
    /* Pausa só com ícone, longe do título e da zona da médica */
    .h1-controles { top: calc(var(--t0) + 8px); }
    .pausa { padding: 0; }
    .pausa-txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (max-width: 374px) { .palco { --info: 110px; } .h1-intro .lead { font-size: 14.5px; } }
  @media (max-width: 760px) and (max-height: 700px) { .h1-vertical { display: none; } }
  @media (max-width: 760px) and (max-height: 620px) {
    .palco { --info: 42px; }
    .h1-intro .lead { display: none; }
  }
</style>

<script>
  import "../../scripts/hero";
</script>
