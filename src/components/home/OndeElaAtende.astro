---
import { marca } from "../../lib/provisorio";
import { clinica, rotas } from "../../data/site";

const { imagem, atendimento } = clinica;
---
<section class="m5" id="onde-ela-atende" aria-labelledby="m5-t">
  <p class="rotulo m5-cap">05 — Onde ela atende</p>
  <figure class="m5-fresta" {...marca(imagem)}>
    <picture>
      <source media="(max-width: 760px)" srcset={imagem.valor.srcMobile} width={imagem.valor.largMobile} height={imagem.valor.altMobile} />
      <img src={imagem.valor.src} alt={imagem.valor.alt} width={imagem.valor.largura} height={imagem.valor.altura} loading="lazy" decoding="async" />
    </picture>
  </figure>
  <h2 class="display m5-nome" id="m5-t"><em>Longatti</em> <em class="m5-vitae">Vitae</em></h2>
  <div class="m5-pe">
    <p class="m5-info" {...marca(atendimento)}>{atendimento.valor.area}<br />{atendimento.valor.local}</p>
    <a class="link-seta m5-link" href={rotas.clinica} target="_blank" rel="noopener">Conhecer a clínica <span aria-hidden="true">→</span><span class="sr-only"> (abre o site da clínica em nova aba)</span></a>
  </div>
</section>

<style is:global>
  /* ===== Cap. 05 — Onde ela atende =====
     Uma passagem curta: o letreiro da clínica, inteiro, e o nome dela. Nada se move.
     A experiência completa do espaço fica para o futuro site da Longatti Vitae. */
  .m5 { display: grid; grid-template-columns: minmax(0, 1fr) auto; background: var(--marfim); color: var(--marrom); padding: var(--e8) 0; }
  .m5-cap { padding: 0 var(--m); color: var(--terracota); }
  /* A caixa tem a proporção da imagem: o letreiro nunca é cortado. Encosta na borda direita */
  .m5-fresta { margin: 0; width: min(60vw, calc(72vh * 1520 / 1080)); aspect-ratio: 1520 / 1080; background: var(--marrom-midia); }
  .m5-fresta picture { display: block; height: 100%; }
  .m5-fresta img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* O nome ocupa a largura inteira: é ele que fica na memória */
  .m5-nome { grid-column: 1 / -1; margin-top: var(--e5); padding: 0 var(--m); font-size: min(14.1vw, 36vh); line-height: .92; letter-spacing: -.04em; white-space: nowrap; }
  .m5-pe { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: flex-end; gap: var(--e5); margin-top: var(--e5); padding: 0 var(--m); }
  .m5-info { font-size: clamp(17px, 1.4vw, 28px); line-height: 1.4; }
  .m5-link { align-items: center; min-height: 44px; }

  /* Celular: o letreiro ocupa a largura inteira, sem corte. O nome vem abaixo, em duas linhas */
  @media (max-width: 760px) {
    .m5 { grid-template-columns: minmax(0, 1fr); padding: var(--e7) 0 var(--e9); }
    .m5-cap { margin-bottom: var(--e5); }
    .m5-fresta { width: 100%; }
    .m5-nome { margin-top: var(--e5); font-size: 23.2vw; line-height: 1.02; white-space: normal; }
    .m5-nome em { display: block; }
    .m5-vitae { text-align: right; }
    .m5-pe { display: grid; justify-items: start; gap: var(--e4); }
    .m5-info { font-size: 17px; }
  }
</style>
